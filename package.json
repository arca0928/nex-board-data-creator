{
	"name": "nexboard-creator",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "cf workers types && vite dev",
		"build": "cf workers types && vite build && cf-wrangler build",
		"preview": "pnpm run build && cf-wrangler dev",
		"prepare": "svelte-kit sync || echo ''",
		"check": "cf workers types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "cf workers types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"gen": "cf workers types",
		"deploy": "pnpm run build && cf deploy --prebuilt",
		"cf-typegen": "cf workers types"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/sveltekit": "^10.4.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.12.4",
		"@types/papaparse": "^5.5.2",
		"@vitest/browser-playwright": "^4.1.7",
		"cf": "1.0.0-beta.5",
		"eslint": "^10.4.0",
		"eslint-plugin-storybook": "^10.4.1",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"storybook": "^10.4.1",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.0",
		"vite": "^8.0.14",
		"vitest": "^4.1.7",
		"vitest-browser-svelte": "^2.1.1",
		"wrangler": "^4.143.0"
	},
	"dependencies": {
		"papaparse": "^5.5.3"
	}
}
